digraph G { rankdir=LR; bgcolor=white; nodesep=0.28; ranksep=0.55; pad=0.12; fontname="Helvetica"; fontsize=12;
node [shape=box style="rounded,filled" fillcolor=white fontname="Helvetica" fontsize=13 height=0.36 margin="0.14,0.05" color="#555555"];
edge [color="#555555" arrowsize=0.7 fontname="Helvetica" fontsize=11];
subgraph cluster_n { label="Now"; labeljust=l; color="#BBBBBB"; style=rounded; margin=12;
n0 [label="C repository (git)" ];
n1 [label="sandbox:\nanonymous BaselineOfC\nfor v1.2, v1.3, ..." fillcolor="#CDEBCF"];
n0->n1 [label="read from git"]; nimg [label="image\nuntouched" fillcolor="#CDEBCF"];
}
subgraph cluster_b { label="Before"; labeljust=l; color="#BBBBBB"; style=rounded; margin=12;
b0 [label="C repository (git)" ];
b1 [label="working copy" fillcolor="#F8C9C4" color="#B3261E" penwidth=2];
b2 [label="image" fillcolor="#F8C9C4" color="#B3261E" penwidth=2];
b0->b1 [label="checkout v1.3"];
